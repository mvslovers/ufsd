//UFSD     PROC M=UFSDPRM0,
//            D='SYS2.PARMLIB'
//*
//* UFSD - Filesystem Server STC Procedure
//*
//* Installation:
//*   Copy to SYS2.PROCLIB(UFSD)
//*
//* Starting:    /S UFSD
//*              /S UFSD,M=UFSDPRM1       (alternate config member)
//*              /S UFSD,D='MY.PARMLIB'   (alternate parmlib dataset)
//* Commands:    /F UFSD,STATS
//*              /F UFSD,MOUNT LIST
//*              /F UFSD,HELP
//*              /F UFSD,SHUTDOWN
//* Stopping:    /P UFSD
//*
//* Recovery:    After an abend (/C or S0Cx) the SSCT and CSA remain
//*              allocated by design; the next /S UFSD reclaims them.
//*              UFSDCLNP is the standalone fallback (see SAMPLIB).
//*
//UFSD     EXEC PGM=UFSD,REGION=4M,TIME=1440
//STEPLIB  DD  DISP=SHR,DSN=@LINKLIB@
//UFSDPRM  DD  DISP=SHR,DSN=&D(&M),FREE=CLOSE
//SYSUDUMP DD  SYSOUT=*
